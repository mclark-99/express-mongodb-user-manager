<h1>Add User</h1>

<form method="POST" action="/add-user">
  <label>
    Name:
    <input type="text" name="name" required>
  </label>

  <br><br>

  <label>
    Gender:
    <select name="gender" required>
      <option value="">Select</option>
      <option>Female</option>
      <option>Male</option>
      <option>Other</option>
    </select>
  </label>

  <br><br>

  <button type="submit">Submit</button>
</form>